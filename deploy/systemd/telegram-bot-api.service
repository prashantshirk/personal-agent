[Unit]
Description=Telegram Bot API server for large file downloads
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secondbrain
Group=secondbrain
EnvironmentFile=/etc/secondbrain/telegram-bot-api.env
ExecStart=/usr/local/bin/telegram-bot-api --local --http-ip-address=127.0.0.1 --http-port=8081 --dir=/var/lib/telegram-bot-api
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/telegram-bot-api
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryHigh=300M
MemoryMax=350M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
