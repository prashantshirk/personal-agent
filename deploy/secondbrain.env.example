# Required: one private Telegram bot and the owner's numeric Telegram user ID.
TELEGRAM_BOT_TOKEN=replace-with-BotFather-token
TELEGRAM_ALLOWED_USER_ID=replace-with-numeric-user-id

# Gemini primary. The fallback order is Gemini 3.1 Flash-Lite, then Groq GPT-OSS 120B.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=replace-with-Gemini-API-key
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,groq:openai/gpt-oss-120b

# One Groq API key is used by the Groq chat fallback and Whisper transcription.
GROQ_API_KEY=replace-with-Groq-API-key
STT_MODEL=whisper-large-v3
STT_LANGUAGE=auto

# Runtime paths and limits.
DATA_DIR=/var/lib/secondbrain/data
TMP_DIR=/var/lib/secondbrain/tmp
TZ=Asia/Kolkata
GOMEMLIMIT=200MiB
LLM_DAILY_TOKEN_BUDGET=100000

# Optional encrypted file storage. Local mode keeps encrypted objects and
# encrypted SQLite backups on this VM; copy backups off the VM for recovery.
# Generate an age identity first, then set FILE_STORAGE_BACKEND=local and
# AGE_RECIPIENT to its public recipient. The default backend is none.
# FILE_STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=/var/lib/secondbrain/data/objects
# AGE_RECIPIENT=age1replace-with-generated-public-recipient
# AGE_IDENTITY_FILE=/etc/secondbrain/age.key

# The default uses Telegram's cloud API. Set these only after installing the
# local Bot API server; keep that server bound to loopback.
# TELEGRAM_API_BASE=http://127.0.0.1:8081
# TELEGRAM_FILE_CACHE_DIR=/var/lib/telegram-bot-api

# Optional integrations. Leave entirely unset until each service is configured.
# For R2 instead, set FILE_STORAGE_BACKEND=r2 and these credentials.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# AGE_RECIPIENT=
# FIRECRAWL_API_KEY=
# NTFY_URL=
# NTFY_TOPIC=secondbrain-alerts
# NTFY_TOKEN=
